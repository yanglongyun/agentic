{
  "manifest_version": 3,
  "name": "agentic",
  "description": "让 agentic 的 Agent 在你的浏览器里打开网页、读取内容、点击和输入。",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "agentic"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

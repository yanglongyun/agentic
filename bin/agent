#!/usr/bin/env bash
# agent-cli —— 一个用 Responses API 实现的 shell agent
# 用法见 agent --help
set -uo pipefail

AGENT_VERSION="0.1.0"

# 解析自身位置（跟随 symlink），定位 lib/
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
    _dir="$(cd -P "$(dirname "$_src")" && pwd)"
    _src="$(readlink "$_src")"
    [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
AGENT_HOME="$(cd -P "$(dirname "$_src")/.." && pwd)"
AGENT_LIB="$AGENT_HOME/lib"

# shellcheck source=/dev/null
. "$AGENT_LIB/util.sh"
. "$AGENT_LIB/config.sh"
. "$AGENT_LIB/history.sh"
. "$AGENT_LIB/api.sh"
. "$AGENT_LIB/tools.sh"
. "$AGENT_LIB/compact.sh"
. "$AGENT_LIB/loop.sh"

config_load
history_init
tools_load

AGENT_RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/agent-cli.XXXXXX")"
AGENT_PENDING_IMAGE="$AGENT_RUN_DIR/pending_image"
cleanup() { spin_stop; rm -rf "$AGENT_RUN_DIR"; }
trap cleanup EXIT

usage() {
    cat <<EOF
${C_BOLD}agent${C_OFF} $AGENT_VERSION —— 终端里的 AI agent（Responses API）

用法:
  agent                    进入对话（全局唯一一个会话，历史自动保存）
  agent "帮我看下磁盘"      问一句就走，同样接着同一个会话
  agent -p "..."           同上

  agent config             交互式配置 url / key / model
  agent config show        看当前配置
  agent config set <项> <值>
                           项：url key model compact-at keep timeout max-output system
  agent history            打印当前对话
  agent compact            立刻压缩上下文
  agent reset              清空对话（原文仍归档在 archive.jsonl）
  agent version            版本

对话中可用:
  /exit  /reset  /compact  /history  /config  /help

工具: bash · read（支持看图）· write · edit
配置: $AGENT_CONFIG_FILE
数据: $AGENT_DATA_DIR
EOF
}

repl() {
    config_require
    ensure_utf8_input
    say "${C_BOLD}agent${C_OFF} $AGENT_VERSION  ${C_GRAY}$AGENT_MODEL @ $PWD${C_OFF}"
    say "${C_GRAY}/help 看命令，/exit 退出。当前上下文 $(history_count) 条。${C_OFF}"
    say ""

    trap 'echo; warn "已取消（再按 Ctrl+C 或 /exit 退出）"' INT

    local line
    while :; do
        printf '%s你 ›%s ' "$C_GREEN" "$C_OFF"
        # AGENT_NO_READLINE=1 关掉行编辑 —— 少数终端下 readline 仍会捣乱时的退路
        if [ "${AGENT_NO_READLINE:-}" = 1 ]; then
            IFS= read -r line || { say ""; break; }
        else
            IFS= read -r -e line || { say ""; break; }
        fi
        case "$line" in
            "") continue ;;
            /exit|/quit) break ;;
            /help) usage; continue ;;
            /reset) history_reset; continue ;;
            /compact) compact_now; continue ;;
            /history) history_dump; continue ;;
            /config) config_wizard; config_load; continue ;;
            /*) warn "未知命令：$line（/help 看可用命令）"; continue ;;
        esac
        printf '%s助理 ›%s\n' "$C_BLUE" "$C_OFF"
        agent_turn "$line"
        say ""
    done
    say "${C_GRAY}再见${C_OFF}"
}

one_shot() {
    config_require
    agent_turn "$1"
}

# ---- 命令分发 ----
case "${1:-}" in
    ""|repl)
        # 管道进来的当作一次性提问
        if [ ! -t 0 ]; then
            input="$(cat)"
            [ -n "$input" ] && one_shot "$input" || usage
        else
            repl
        fi
        ;;
    -h|--help|help) usage ;;
    version|--version|-v) say "agent $AGENT_VERSION" ;;
    config)
        case "${2:-}" in
            ""|wizard) config_wizard ;;
            show) config_show ;;
            set)
                [ $# -ge 4 ] || die "用法：agent config set <项> <值>"
                config_set "$3" "$4"
                ;;
            *) die "用法：agent config [show|set <项> <值>]" ;;
        esac
        ;;
    reset)   history_reset ;;
    compact) config_require; compact_now ;;
    history) history_dump ;;
    -p)
        shift
        [ $# -ge 1 ] || die "用法：agent -p \"你的问题\""
        one_shot "$*"
        ;;
    *) one_shot "$*" ;;
esac

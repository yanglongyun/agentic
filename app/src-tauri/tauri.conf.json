{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentic",
  "version": "0.3.0",
  "identifier": "ai.agentic.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "settings"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "../../build/icon.icns",
      "../../build/icon.png"
    ],
    "resources": {
      "../../extension/": "extension/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}

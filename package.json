{
  "name": "agentic",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "agentic：Tauri + Rust 本机执行客户端、浏览器插件、Cloudflare Worker",
  "license": "MIT",
  "scripts": {
    "setup": "npm ci --prefix app && npm ci --prefix worker",
    "app": "npm --prefix app run dev",
    "build:ui": "npm --prefix worker run build:web",
    "test": "npm --prefix app test",
    "pack:mac": "npm --prefix app run pack",
    "build:app": "npm --prefix app run build",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy"
  }
}
